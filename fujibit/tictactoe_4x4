<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>4x4 Tic-Tac-Toe</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      background: #f4f4f5;
    }

    h1 {
      margin-bottom: 10px;
    }

    #status {
      font-size: 1.3rem;
      margin-bottom: 16px;
      min-height: 1.8rem;
      font-weight: 600;
    }

    .board {
      display: grid;
      grid-template-columns: repeat(4, 90px);
      grid-template-rows: repeat(4, 90px);
      gap: 8px;
      background: #18181b;
      padding: 8px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .cell {
      background: #fafafa;
      border: none;
      border-radius: 8px;
      font-size: 2.5rem;
      font-weight: 700;
      color: #18181b;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
    }

    .cell:hover:not(:disabled) {
      background: #e4e4e7;
      transform: scale(0.97);
    }

    .cell:disabled {
      cursor: default;
    }

    .cell.win {
      background: #4ade80;
      color: #14532d;
    }

    button {
      margin-top: 20px;
      padding: 10px 22px;
      font-size: 1rem;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      background: #18181b;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background: #3f3f46;
    }
  </style>
</head>
<body>
  <h1>4x4 Tic-Tac-Toe</h1>
  <div id="status">Player X's turn</div>
  <div class="board" id="board"></div>
  <button id="reset">Reset Game</button>

  <script>
    const boardEl = document.getElementById('board');
    const statusEl = document.getElementById('status');
    const resetBtn = document.getElementById('reset');

    let board = Array(16).fill('');
    let currentPlayer = 'X';
    let gameOver = false;
    let winningLine = null;

    function render() {
      boardEl.innerHTML = '';
      board.forEach((value, index) => {
        const cell = document.createElement('button');
        cell.className = 'cell';
        cell.textContent = value;
        cell.disabled = gameOver || value !== '';
        if (winningLine && winningLine.includes(index)) {
          cell.classList.add('win');
        }
        cell.addEventListener('click', () => handleMove(index));
        boardEl.appendChild(cell);
      });

      if (gameOver) {
        if (winningLine) {
          statusEl.textContent = `Player ${currentPlayer} wins!`;
        } else {
          statusEl.textContent = "It's a draw!";
        }
      } else {
        statusEl.textContent = `Player ${currentPlayer}'s turn`;
      }
    }

    function getWinningLine() {
      const lines = [];

      // Rows
      for (let r = 0; r < 4; r++) {
        lines.push([0, 1, 2, 3].map(c => r * 4 + c));
      }

      // Columns
      for (let c = 0; c < 4; c++) {
        lines.push([0, 1, 2, 3].map(r => r * 4 + c));
      }

      // Diagonals
      lines.push([0, 5, 10, 15]);
      lines.push([3, 6, 9, 12]);

      for (const line of lines) {
        const [a, b, c, d] = line;
        if (
          board[a] &&
          board[a] === board[b] &&
          board[a] === board[c] &&
          board[a] === board[d]
        ) {
          return line;
        }
      }

      return null;
    }

    function handleMove(index) {
      if (gameOver || board[index]) return;

      board[index] = currentPlayer;
      winningLine = getWinningLine();

      if (winningLine) {
        gameOver = true;
      } else if (board.every(cell => cell !== '')) {
        gameOver = true;
      } else {
        currentPlayer = currentPlayer === 'X' ? 'O' : 'X';
      }

      render();
    }

    function resetGame() {
      board = Array(16).fill('');
      currentPlayer = 'X';
      gameOver = false;
      winningLine = null;
      render();
    }

    resetBtn.addEventListener('click', resetGame);

    render();
  </script>
</body>
</html>